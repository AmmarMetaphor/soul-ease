# ─────────────────────────────────────────────────────────────────────────────
# Soul Ease — environment variables
#
# Copy this file to `.env` for local development. Never commit `.env`.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (browser-safe) ──────────────────────────────────────────────────
# Found under Supabase → Project Settings → API.
# The anon key is designed to be public; data access is protected by
# Row Level Security policies in supabase/migrations.
#
# Leave BOTH blank to run the app in DEMO MODE (local-only storage, no network).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── App behaviour (browser-safe) ─────────────────────────────────────────────
# Number of free sessions before the upgrade placeholder appears. Default: 3
VITE_FREE_SESSION_ALLOWANCE=3

# Force demo mode even when Supabase variables are present (useful for previews).
VITE_FORCE_DEMO_MODE=false

# Public URL of the deployed site, used for auth email redirects.
# Leave blank to use window.location.origin at runtime.
VITE_PUBLIC_SITE_URL=

# Conversation engine: "demo" (Phase 1 default) or "openai" (Phase 2 scaffold —
# falls back to demo until the realtime integration is completed).
VITE_REALTIME_PROVIDER=demo

# Routing: "browser" (default, clean URLs via the Netlify SPA rewrite) or
# "hash" for static hosts without rewrite support (standalone previews).
VITE_ROUTER_MODE=browser

# ── Server-side only (Netlify Functions) — NEVER prefix these with VITE_ ─────
# Used by netlify/functions/realtime-token.ts to verify the caller's Supabase
# session before minting a short-lived realtime client credential.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Phase 2: OpenAI Realtime. The permanent key must only ever exist here, on the
# server. If unset, the token endpoint returns 503 and the app stays in demo mode.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
