# ─────────────────────────────────────────────────────────────────────────────
# Soul Ease — environment variables
#
# Copy this file to `.env` for local development. Never commit `.env`.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
#
# The OpenAI key is SERVER-ONLY. There is deliberately no VITE_OPENAI_API_KEY
# and there must never be one — that would ship a paid credential to every
# visitor.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ SERVER-SIDE ONLY — never prefix these with VITE_ ═══════════════════════
# Read by the Cloudflare Pages Function (functions/api/realtime/session.ts)
# and the Netlify Function (netlify/functions/realtime-token.ts), which share
# server/realtime/session.ts.

# Realtime voice. Without this the endpoint returns 503 and the session screen
# says Noor is unavailable. Nothing stands in for the conversation.
OPENAI_API_KEY=

# Realtime model. Default: gpt-realtime-2.1
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Input transcription model. Default: gpt-transcribe, which accepts a LIST of
# possible languages — what Urdu-English code-switching needs. Pinning a single
# language degrades the other, and a mistranscribed turn reaches the model as
# words the member never said. Only gpt-transcribe and gpt-live-transcribe
# accept the list; with any other model it is omitted.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Noor's voice. The server has the final say. Default: marin
# Supported: marin, cedar, coral, shimmer, sage, alloy, ash, ballad, echo, verse
NOOR_VOICE=marin

# Lifetime of the ephemeral client secret, in seconds (10–7200). Default: 120
REALTIME_SECRET_TTL_SECONDS=120

# Used to verify the caller's Supabase JWT before minting a realtime
# credential. Without these the endpoint refuses every request unless
# ALLOW_UNAUTHENTICATED_REALTIME is explicitly set (see below).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Preview escape hatch. When Supabase is not configured there is no member to
# authenticate, so the realtime endpoint refuses by default rather than
# leaving an open door to a paid API key. Set to true ONLY for a private
# preview you control, and never for production.
ALLOW_UNAUTHENTICATED_REALTIME=false

# ═══ BROWSER (VITE_) ════════════════════════════════════════════════════════

# Supabase, from Project Settings → API. The anon key is designed to be
# public; access is protected by the Row Level Security policies in
# supabase/migrations.
#
# Leave BOTH blank to run the app in DEMO MODE (browser-local storage only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Number of free sessions before the upgrade placeholder appears. Default: 3
VITE_FREE_SESSION_ALLOWANCE=3

# Force demo mode even when Supabase variables are present.
VITE_FORCE_DEMO_MODE=false

# Public URL of the deployed site, used for auth email redirects.
# Leave blank to use window.location.origin at runtime.
VITE_PUBLIC_SITE_URL=

# Conversation engine:
#   auto   (default) the realtime model. If it cannot connect, the member is
#          told Noor is unavailable — nothing stands in for the conversation.
#   openai identical today; kept as an explicit "realtime only" declaration
#   demo   the SCRIPTED INTERFACE HARNESS. Replies come from fixed pre-written
#          line pools chosen by topic regex, read out by the browser's own
#          voice. It cannot understand a sentence and will answer two different
#          problems with nearly the same words. For reviewing layout and
#          conversation states with no credentials — never for a real member.
#          A demo build says so in the session UI on every turn.
VITE_REALTIME_PROVIDER=auto

# Client-side hint for Noor's voice. The server value decides; this only keeps
# the dev UI honest about what it expects. Members never see a voice selector.
VITE_NOOR_VOICE=marin

# Set to true only once a designed raster portrait exists at
# public/images/noor/noor-portrait.webp (+ @2x). Off by default so a missing
# asset is never requested: Noor's original vector artwork renders instead.
VITE_NOOR_PORTRAIT_ASSET=false

# Developer tools: the voice-audition page (/app/dev/voice) and the realtime
# diagnostics panel. Always on in `npm run dev`. Set to true to enable them in
# a deployed preview. MUST stay false/unset in production.
VITE_ENABLE_DEV_TOOLS=false

# Routing: "browser" (default, clean URLs via the host's SPA rewrite) or
# "hash" for static hosts without rewrite support.
VITE_ROUTER_MODE=browser
